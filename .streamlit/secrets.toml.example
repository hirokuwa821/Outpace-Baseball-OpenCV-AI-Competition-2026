# .streamlit/secrets.toml.example
# Template for Streamlit Community Cloud or local Streamlit secrets.
# NEVER commit your real secrets.toml to git.

AWS_ACCESS_KEY_ID = "YOUR_AWS_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY = "YOUR_AWS_SECRET_ACCESS_KEY"
AWS_DEFAULT_REGION = "YOUR_REGION"
AWS_REGION = "YOUR_REGION"
AWS_S3_BUCKET_NAME = "YOUR_BUCKET_NAME"

# Optional: Override Bedrock model ID if needed (defaults to amazon.nova-2-lite-v1:0 with regional profile)
# BEDROCK_MODEL_ID = "amazon.nova-2-lite-v1:0"
