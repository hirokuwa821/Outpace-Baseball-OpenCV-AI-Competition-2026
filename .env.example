# RevenueCat Billing SDK Configuration (Sandbox / Shipaton Demo Template)
# Copy this file to .env and replace placeholders with your actual RevenueCat credentials.

# RevenueCat Billing Sandbox Public API Key (Client-side Web SDK: rcb_sb_...)
REVENUECAT_API_KEY=rcb_sb_your_revenuecat_api_key_here

# RevenueCat Secret API Key (Server-side Python REST API verification only - NEVER expose to client)
REVENUECAT_SECRET_KEY=sk_your_revenuecat_secret_key_here

# Entitlement Identifier configured in RevenueCat Dashboard
REVENUECAT_ENTITLEMENT_ID=outpose_baseball_pro

# Product & Offering IDs
REVENUECAT_PRODUCT_ID=outpose_pro_monthly
REVENUECAT_OFFERING_ID=default

# Environment Mode: sandbox or production
REVENUECAT_ENVIRONMENT=sandbox



