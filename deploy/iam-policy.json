{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3VideoBucketListing",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::YOUR_BUCKET_NAME"
    },
    {
      "Sid": "S3VideoAndResultsReadWrite",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::YOUR_BUCKET_NAME/videos/*",
        "arn:aws:s3:::YOUR_BUCKET_NAME/results/*"
      ]
    },
    {
      "Sid": "BedrockNovaInference",
      "Effect": "Allow",
      "Action": [
        "bedrock:InvokeModel",
        "bedrock:InvokeModelWithResponseStream"
      ],
      "Resource": [
        "arn:aws:bedrock:*::foundation-model/amazon.nova-2-lite-v1:0",
        "arn:aws:bedrock:*:*:inference-profile/jp.amazon.nova-2-lite-v1:0",
        "arn:aws:bedrock:*:*:inference-profile/us.amazon.nova-2-lite-v1:0",
        "arn:aws:bedrock:*:*:inference-profile/eu.amazon.nova-2-lite-v1:0",
        "arn:aws:bedrock:*:*:inference-profile/global.amazon.nova-2-lite-v1:0"
      ]
    }
  ]
}
